# ==============================
# Required API Keys (manual step)
# ==============================
ALPACA_API_KEY=PASTE_YOUR_ALPACA_API_KEY
ALPACA_SECRET_KEY=PASTE_YOUR_ALPACA_SECRET_KEY
FINNHUB_API_KEY=PASTE_YOUR_FINNHUB_API_KEY

# ==============================
# Trading mode
# ==============================
PAPER_TRADING=true
AUTO_START_MODE=autonomous

# ==============================
# Bot behavior
# ==============================
AUTONOMOUS_INTERVAL_MINUTES=30
ENABLE_DYNAMIC_OPTIMIZATION=true
OPTIMIZATION_LOOKBACK_DAYS=90
ENABLE_WEEKLY_AUTO_REWEIGHT=true
BACKTEST_LOOKBACK_WEEKS=26
BACKTEST_OOS_WEEKS=8
SHOW_OPTIMIZATION_REPORT=true

# ==============================
# Ensemble behavior
# ==============================
MIN_ENSEMBLE_CONFIDENCE=0.55
EXTERNAL_POLITICIAN_BIAS=0.15

# Confirmed entry model (must match validated backtest logic)
ENABLE_CONFIRMED_ENTRY_MODEL=true
ENTRY_CONFIRMATION_MODE=boolean
ENTRY_MIN_CONFIRMATIONS=2
ENTRY_CONFIRMATION_WEIGHT_THRESHOLD=0.60
ENABLE_PATTERN_OVERLAY=false
PATTERN_OVERLAY_MODE=weighted
PATTERN_WEIGHT=0.08

# ==============================
# Position and risk defaults
# ==============================
DEFAULT_BUY_NOTIONAL=100.0
TAKE_PROFIT_PCT=5.0
STOP_LOSS_PCT=-3.0
MAX_POSITION_PCT_OF_EQUITY=0.20
MAX_TOTAL_EXPOSURE_PCT_OF_EQUITY=0.75
MIN_CASH_RESERVE_PCT=0.10
DAILY_LOSS_LIMIT_PCT=0.02
MAX_TRADES_PER_DAY=10
HARD_MIN_ORDER_NOTIONAL=1.0

# Live-mode startup cap (applies when PAPER_TRADING=false)
REAL_MONEY_START_BUDGET=25.0

# ==============================
# Per-trade risk sizing
# position_notional = equity * risk_pct / abs(stop_loss_pct)
# ==============================
MAX_RISK_PER_TRADE_PCT=0.01    # 1% of equity max risk per trade
MIN_RISK_PER_TRADE_PCT=0.005   # 0.5% of equity min risk per trade
POSITION_SIZE_PCT_OF_EQUITY=0.03  # Target notional as % of equity (bounded by risk caps)

# ==============================
# Concurrent position cap
# ==============================
MAX_CONCURRENT_POSITIONS=5

# ==============================
# Allowed tickers (comma-separated; leave empty for no restriction)
# ==============================
# ALLOWED_TICKERS=AAPL,MSFT,NVDA,GOOGL,AMZN

# Diversified universe used by live bot (recommended 5-20 liquid symbols)
# TICKER_UNIVERSE=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,BAC,WMT

# ==============================
# Trading hours (US/Eastern, HH:MM 24-h)
# ==============================
TRADING_START_TIME=09:30
TRADING_END_TIME=15:30
# Comma-separated HH:MM-HH:MM blackout windows (high-volatility / open-close)
NO_TRADE_WINDOWS=09:30-09:45,15:30-16:00

# ==============================
# Portfolio-level diversification risk rails
# ==============================
MAX_SECTOR_CONCENTRATION_PCT=0.40
MAX_TOTAL_OPEN_RISK_PCT=0.02

# ==============================
# Optional testing controls
# ==============================
FORCE_TEST_BUY=false
FORCE_TEST_BUY_TICKER=AAPL
FORCE_TEST_BUY_NOTIONAL=25

# ==============================
# Runtime tuning
# ==============================
HTTP_TIMEOUT_SECONDS=10
DASHBOARD_DEBUG=false
