[Unit]
Description=Stock Bot Dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=botuser
WorkingDirectory=/home/botuser/stock-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/botuser/stock-bot/.venv/bin/python /home/botuser/stock-bot/dashboard.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
